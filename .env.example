# Copy this file to .env and replace every value before running Docker Compose.
# Do not commit .env or the PEM files under ./secrets/.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_USER=wms_app
MYSQL_PASSWORD=replace-with-a-long-random-application-password

# 默认只绑定本机，正式公网访问应由 HTTPS 反向代理转发；确需外部访问时再显式修改。
# WMS_MGMT_BIND 是 actuator 端口（/actuator/health、/actuator/prometheus），仅供内网采集器抓取，不要对公网暴露。
WMS_MYSQL_BIND=127.0.0.1:3306
WMS_API_BIND=127.0.0.1:8088
WMS_MGMT_BIND=127.0.0.1:9089
WMS_WEB_BIND=127.0.0.1:3000

# 审计日志归档（可选，留空即用默认值）。归档 CSV 默认写在 wms-logs 卷的 /app/logs/archive。
# AUDIT_ARCHIVE_AFTER_DAYS=365
# 打开下面这项会真删 operation_logs 里已归档的行，不可逆；必须先确认归档目录已进备份。
# AUDIT_ARCHIVE_DELETE_ENABLED=false

WECHAT_APPID=wx_replace_me
WECHAT_SECRET=replace-with-miniapp-secret
WECHAT_PAY_MCH_ID=replace-with-merchant-id
WECHAT_PAY_MCH_SERIAL=replace-with-merchant-certificate-serial
WECHAT_PAY_API_V3_KEY=replace-with-32-character-api-v3-key
WECHAT_PAY_PUB_KEY_ID=replace-with-wechat-pay-public-key-id
WECHAT_PAY_NOTIFY_URL=https://example.com/api/v1/market/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://example.com/api/v1/market/pay/refund-notify
WECHAT_PAY_PRIVATE_KEY_FILE=./secrets/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_FILE=./secrets/wechatpay_public_key.pem

# 仅首次初始化空生产库时临时填写；首次启动成功后立即从 .env 删除。
WMS_BOOTSTRAP_ADMIN_USERNAME=replace-with-initial-admin
WMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-initial-password
