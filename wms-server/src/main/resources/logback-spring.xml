<?xml version="1.0" encoding="UTF-8"?>
<!-- 上线整改 A4：容器日志随容器销毁而丢失，这里在保留控制台输出的同时落盘并按天+按大小轮转。 -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${WMS_LOG_DIR:-logs}"/>
    <!-- traceId 由 TraceIdFilter 写入 MDC，缺省时打印 unknown 而不是留空破坏列对齐 -->
    <property name="WMS_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [trace:%X{traceId:-unknown}] %-5level %logger{40} - %msg%n"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wms-server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wms-server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE:-50MB}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY:-30}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP:-2GB}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${WMS_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL_ROOT:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
